# ---------------------------------------------------------------------------
# SentinelASM - Environment Configuration Template
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# Application
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key

# Database
# Leave DATABASE_URL unset to use the built-in default (an absolute path to
# instance/sentinelasm.db, resolved automatically by config.py).
# If you do set it for SQLite, use an ABSOLUTE path with 4 slashes, e.g.:
# DATABASE_URL=sqlite:////absolute/path/to/SentinelASM/instance/sentinelasm.db
# (Flask-SQLAlchemy resolves relative "sqlite:///" URIs against the Flask
# instance folder, not your shell's working directory, which can cause
# confusing "unable to open database file" errors with relative paths.)
#
# PostgreSQL (production ready) example:
# DATABASE_URL=postgresql+psycopg2://sentinel_user:sentinel_pass@localhost:5432/sentinelasm

# Session / Cookies
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False
REMEMBER_COOKIE_DURATION_DAYS=14

# Mail (placeholders - wire up a real provider for production)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=no-reply@sentinelasm.local
MAIL_PASSWORD=change-me
MAIL_DEFAULT_SENDER=SentinelASM <no-reply@sentinelasm.local>

# Security
PASSWORD_RESET_TOKEN_MAX_AGE_SECONDS=1800
RATELIMIT_STORAGE_URI=memory://

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=True

# Threat Intelligence (CVE Engine)
# NVD_API_KEY is optional - requests work without it at a lower rate limit.
# Get one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# EPSS (api.first.org) needs no key. Set EPSS_ENABLED=False to skip EPSS
# lookups entirely (e.g. offline/air-gapped environments).
EPSS_ENABLED=True
EPSS_TIMEOUT_SECONDS=5
